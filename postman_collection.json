{
  "info": {
    "name": "Hotel Booking Service",
    "description": "Full API for the hotel booking service.\n\n**Run the folders top to bottom** (or hit Run on the collection) \u2014 each request saves the ids the next one needs into collection variables, so nothing has to be pasted by hand.\n\nStay dates are generated by the collection's pre-request script as today+45 \u2192 today+48, so the collection never goes stale.\n\nOnly `baseUrl` needs setting: default `http://localhost:8080/api/v1`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "groupId",
      "value": ""
    },
    {
      "key": "propertyId",
      "value": ""
    },
    {
      "key": "roomTypeId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "idempotencyKey",
      "value": ""
    },
    {
      "key": "checkIn",
      "value": ""
    },
    {
      "key": "checkOut",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Stay dates are always in the future, so the collection never expires.",
          "const iso = d => d.toISOString().slice(0, 10);",
          "const plus = n => { const d = new Date(); d.setDate(d.getDate() + n); return iso(d); };",
          "pm.collectionVariables.set('checkIn',  plus(45));",
          "pm.collectionVariables.set('checkOut', plus(48));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. System",
      "description": "Read-only. Confirms the service is up and shows which pluggable pieces it discovered at startup.",
      "item": [
        {
          "name": "Capabilities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/system/capabilities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "system",
                "capabilities"
              ]
            },
            "description": "Which gateways, policies and filter chains were discovered, and which database is behind the ports."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('3 payment gateways', () => pm.expect(b.paymentMethods).to.have.lengthOf(3));",
                  "pm.test('3 cancellation policies', () => pm.expect(b.cancellationPolicies).to.have.lengthOf(3));",
                  "pm.test('no JDBC URL leaked', () => pm.expect(JSON.stringify(b)).to.not.include('jdbc:'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancellation policies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/property-groups/cancellation-policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property-groups",
                "cancellation-policies"
              ]
            },
            "description": "Valid values for `cancellationPolicyCode` when onboarding."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('lists FLEXIBLE', () => pm.expect(pm.response.json().supported).to.include('FLEXIBLE'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Onboarding",
      "description": "One path onboards a standalone hotel and a fifty-property chain. `standalone` is derived by counting properties, never stored \u2014 so a solo owner becoming a chain is an INSERT, not a migration.",
      "item": [
        {
          "name": "Onboard an owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/property-groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property-groups"
              ]
            },
            "description": "Creates the owner, its properties, their room types, and opens nightly inventory for each.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupName\": \"Coastline Hotels\",\n  \"contactEmail\": \"owner@coastline.example\",\n  \"properties\": [\n    {\n      \"name\": \"Coastline Grand\",\n      \"city\": \"Mysuru\",\n      \"locality\": \"Gokulam\",\n      \"addressLine\": \"12 Palace Road\",\n      \"starRating\": 5,\n      \"amenities\": [\n        \"WIFI\",\n        \"POOL\",\n        \"SPA\"\n      ],\n      \"cancellationPolicyCode\": \"FLEXIBLE\",\n      \"roomTypes\": [\n        {\n          \"name\": \"Deluxe King\",\n          \"maxOccupancy\": 2,\n          \"totalRooms\": 8,\n          \"basePricePerNight\": 6500\n        },\n        {\n          \"name\": \"Penthouse\",\n          \"maxOccupancy\": 4,\n          \"totalRooms\": 1,\n          \"basePricePerNight\": 28000\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('groupId', b.id);",
                  "pm.collectionVariables.set('propertyId', b.properties[0].id);",
                  "pm.collectionVariables.set('roomTypeId', b.properties[0].roomTypes[0].id);",
                  "pm.test('one property means standalone', () => pm.expect(b.standalone).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add a property (standalone becomes a chain)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/property-groups/{{groupId}}/properties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property-groups",
                "{{groupId}}",
                "properties"
              ]
            },
            "description": "The same owner grows. Note this property runs MODERATE while the first runs FLEXIBLE \u2014 policy is data on the property, so one chain can offer different terms per hotel.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coastline Loft\",\n  \"city\": \"Mysuru\",\n  \"locality\": \"Jayalakshmipuram\",\n  \"addressLine\": \"5 Cross\",\n  \"starRating\": 3,\n  \"amenities\": [\n    \"WIFI\"\n  ],\n  \"cancellationPolicyCode\": \"MODERATE\",\n  \"roomTypes\": [\n    {\n      \"name\": \"Studio\",\n      \"maxOccupancy\": 2,\n      \"totalRooms\": 4,\n      \"basePricePerNight\": 2800\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the owner",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/property-groups/{{groupId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "property-groups",
                "{{groupId}}"
              ]
            },
            "description": "`standalone` has flipped to false on its own \u2014 nothing set it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('now a chain', () => pm.expect(b.standalone).to.be.false);",
                  "pm.test('two properties', () => pm.expect(b.propertyCount).to.eql(2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Search",
      "description": "POST, not GET: the criteria are a structured object with a nested amenity set. Only genuinely bookable results are returned \u2014 a room must be free on every night of the stay.",
      "item": [
        {
          "name": "Search (no filters)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties",
                "search"
              ]
            },
            "description": "City, dates and party size are the only required fields.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Mysuru\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"guests\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('finds our property', () => pm.expect(b.resultCount).to.be.above(0));",
                  "const mine = b.results.find(r => r.propertyId === pm.collectionVariables.get('propertyId'));",
                  "pm.test('both room types offered', () => pm.expect(mine.availableRoomTypes).to.have.lengthOf(2));",
                  "pm.collectionVariables.set('roomTypeId', mine.availableRoomTypes[0].roomTypeId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search (price cap, amenities, rating)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties",
                "search"
              ]
            },
            "description": "The price cap narrows the ROOMS offered, not just the hotels listed: the property qualifies on its cheap room, but the 28,000 Penthouse is excluded from the results.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Mysuru\",\n  \"locality\": \"Gokulam\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"guests\": 2,\n  \"maxNightlyPrice\": 10000,\n  \"amenities\": [\n    \"WIFI\",\n    \"POOL\"\n  ],\n  \"minStarRating\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const mine = b.results.find(r => r.propertyId === pm.collectionVariables.get('propertyId'));",
                  "pm.test('property still qualifies', () => pm.expect(mine).to.not.be.undefined);",
                  "pm.test('over-budget Penthouse excluded', () => pm.expect(mine.availableRoomTypes.map(o => o.name)).to.eql(['Deluxe King']));",
                  "pm.test('money is a string, not a float', () => pm.expect(mine.availableRoomTypes[0].totalForStay.amount).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Booking",
      "description": "Inventory is taken BEFORE any money moves, so a booking starts PENDING_PAYMENT. Every hold carries holdExpiresAt (15 min) after which a sweeper returns the rooms to sale.",
      "item": [
        {
          "name": "Create a booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ]
            },
            "description": "Holds rooms for every night of [checkIn, checkOut). The checkout night is NOT held.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyId\": \"{{propertyId}}\",\n  \"roomTypeId\": \"{{roomTypeId}}\",\n  \"guestName\": \"Asha Rao\",\n  \"guestEmail\": \"asha@example.com\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"guests\": 2,\n  \"rooms\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', b.id);",
                  "pm.test('starts unpaid', () => pm.expect(b.status).to.eql('PENDING_PAYMENT'));",
                  "pm.test('3 nights', () => pm.expect(b.nights).to.eql(3));",
                  "pm.test('tells you the legal next states', () => pm.expect(b.allowedNextStates).to.include('CONFIRMED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get the booking",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List a guest's bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings?guestEmail=asha@example.com",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings"
              ],
              "query": [
                {
                  "key": "guestEmail",
                  "value": "asha@example.com"
                }
              ]
            },
            "description": "Newest first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Payment",
      "description": "The payment outcome drives the booking state. Idempotency-Key is REQUIRED \u2014 payment is the one operation where a retry costs real money.",
      "item": [
        {
          "name": "Pay \u2014 declined",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "DECLINE-{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "payments"
              ]
            },
            "description": "The mock CARD gateway declines when the Idempotency-Key starts with DECLINE. Note this returns 201, not an error: a decline is a recorded business outcome, and the booking stays PENDING_PAYMENT so the guest can try again while the hold lasts.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"CARD\",\n  \"payerReference\": \"4111111111111111\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('payment failed', () => pm.expect(b.status).to.eql('FAILED'));",
                  "pm.test('reason given', () => pm.expect(b.failureReason).to.be.a('string'));",
                  "pm.test('booking still payable', () => pm.expect(b.booking.status).to.eql('PENDING_PAYMENT'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay \u2014 success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "payments"
              ]
            },
            "description": "A successful charge confirms the booking. Nothing else in the codebase can confirm one.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"CARD\",\n  \"payerReference\": \"4111111111111111\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh key per attempt. Reusing the declined one would replay the decline.",
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('successful', () => pm.expect(b.status).to.eql('SUCCESSFUL'));",
                  "pm.test('payment confirmed the booking', () => pm.expect(b.booking.status).to.eql('CONFIRMED'));",
                  "pm.test('not a replay', () => pm.expect(b.idempotentReplay).to.be.false);",
                  "pm.collectionVariables.set('paymentId', b.paymentId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay again with the SAME key (idempotent replay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "payments"
              ]
            },
            "description": "Identical request, same key. Returns 200 instead of 201, the original paymentId, and idempotentReplay=true. The gateway is NOT called a second time and no second payment exists.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"CARD\",\n  \"payerReference\": \"4111111111111111\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('flagged as a replay', () => pm.expect(b.idempotentReplay).to.be.true);",
                  "pm.test('same payment returned', () => pm.expect(b.paymentId).to.eql(pm.collectionVariables.get('paymentId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay a confirmed booking (rejected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "payments"
              ]
            },
            "description": "409, because the lifecycle forbids it \u2014 not 400, since the request itself was fine.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"method\": \"UPI\",\n  \"payerReference\": \"asha@upi\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('state machine rejected it', () => pm.expect(pm.response.json().code).to.eql('ILLEGAL_STATE_TRANSITION'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List payment attempts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "payments"
              ]
            },
            "description": "Includes the failed attempt, which is what makes a decline-then-retry legible afterwards."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('decline and success both recorded', () => pm.expect(pm.response.json().length).to.be.at.least(2));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Cancellation",
      "description": "Releases rooms, then settles whatever refund the policy allows. The two are independent: a NON_REFUNDABLE booking still gives its rooms back.",
      "item": [
        {
          "name": "Cancel the booking",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/cancellation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "cancellation"
              ]
            },
            "description": "FLEXIBLE gives a full refund outside 24 hours. refundReason states which rule fired."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('cancelled', () => pm.expect(b.booking.status).to.eql('CANCELLED'));",
                  "pm.test('policy applied', () => pm.expect(b.appliedPolicy).to.eql('FLEXIBLE'));",
                  "pm.test('room released', () => pm.expect(b.roomsReleased).to.eql(1));",
                  "pm.test('refund explained', () => pm.expect(b.refundReason).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel again (rejected)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}/cancellation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "bookings",
                "{{bookingId}}",
                "cancellation"
              ]
