                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('double cancellation refused', () => pm.expect(pm.response.json().code).to.eql('ILLEGAL_STATE_TRANSITION'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search again \u2014 the room is back",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/properties/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "properties",
                "search"
              ]
            },
            "description": "The released room is immediately discoverable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"city\": \"Mysuru\",\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"guests\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('property discoverable again', () => pm.expect(pm.response.json().results.some(r => r.propertyId === pm.collectionVariables.get('propertyId'))).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
